# Supabase — project "pnl analyzer" (irdphvymlbstqfyxpxzl)
NEXT_PUBLIC_SUPABASE_URL=https://irdphvymlbstqfyxpxzl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gCe8RJRDb4VkebsIvipHgw_Qw_b-gsC
# server-only, never expose: Supabase dashboard > Project Settings > API keys > secret
SUPABASE_SECRET_KEY=

# Email — SMTP on the Google Workspace mailbox that owns the sending address,
# so there is no third-party domain to verify. SMTP_PASSWORD is a Google App
# Password (myaccount.google.com > Security > 2-Step Verification > App
# passwords), NOT the account password: Workspace rejects that for SMTP.
# Host and port default to smtp.gmail.com:465; unset SMTP_PASSWORD logs instead
# of sending, which is what local dev and CI run on.
SMTP_USER=keng@ikorek.com
SMTP_PASSWORD=
EMAIL_FROM="Margin Lab <keng@ikorek.com>"

# Guards the nudge function against being triggered by anyone who knows its URL.
# Netlify's own scheduled runs are recognised by their next_run body and do not
# need it; this is for invoking the endpoint by hand:
#   curl -X POST -H "x-nudge-secret: $NUDGE_SECRET" <site>/.netlify/functions/nudge
# Generate one with: openssl rand -hex 32
NUDGE_SECRET=

# Meta Marketing API — FB Custom Audience export (module 05)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# WhatsApp — provider not chosen yet (module 05)
WHATSAPP_PROVIDER=none
